// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`synthesize(mcp preset) > matches the CloudFormation snapshot 1`] = `
{
  "Outputs": {
    "McpServerAlbDnsName": {
      "Value": {
        "Fn::GetAtt": [
          "McpServerAlb",
          "DNSName",
        ],
      },
    },
    "McpServerAlbHostedZoneId": {
      "Value": {
        "Fn::GetAtt": [
          "McpServerAlb",
          "CanonicalHostedZoneID",
        ],
      },
    },
    "McpServerLogGroupName": {
      "Value": {
        "Ref": "McpServerLogGroup",
      },
    },
    "McpServerServiceUrl": {
      "Value": "https://mcp.example.com",
    },
  },
  "Resources": {
    "McpServerAlb": {
      "Properties": {
        "LoadBalancerAttributes": [
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "3600",
          },
        ],
        "Name": "mcp-prod-mcp-server",
        "Scheme": "internet-facing",
        "SecurityGroups": [
          {
            "Ref": "McpServerAlbSecurityGroup",
          },
        ],
        "Subnets": [
          "subnet-aaa",
          "subnet-bbb",
          "subnet-ccc",
        ],
        "Type": "application",
      },
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
    },
    "McpServerAlbSecurityGroup": {
      "Properties": {
        "GroupDescription": "ALB ingress for mcp-prod-mcp-server",
        "SecurityGroupIngress": [
          {
            "CidrIp": "0.0.0.0/0",
            "FromPort": 80,
            "IpProtocol": "tcp",
            "ToPort": 80,
          },
          {
            "CidrIp": "0.0.0.0/0",
            "FromPort": 443,
            "IpProtocol": "tcp",
            "ToPort": 443,
          },
        ],
        "VpcId": "vpc-00000000",
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
    "McpServerCertificate": {
      "Properties": {
        "DomainName": "mcp.example.com",
        "DomainValidationOptions": [
          {
            "DomainName": "mcp.example.com",
            "HostedZoneId": "Z0EXAMPLE000000001",
          },
        ],
        "ValidationMethod": "DNS",
      },
      "Type": "AWS::CertificateManager::Certificate",
    },
    "McpServerCluster": {
      "Properties": {
        "CapacityProviders": [
          "FARGATE",
          "FARGATE_SPOT",
        ],
        "ClusterName": "mcp-prod",
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "disabled",
          },
        ],
      },
      "Type": "AWS::ECS::Cluster",
    },
    "McpServerDnsRecord": {
      "Properties": {
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "McpServerAlb",
              "DNSName",
            ],
          },
          "EvaluateTargetHealth": true,
          "HostedZoneId": {
            "Fn::GetAtt": [
              "McpServerAlb",
              "CanonicalHostedZoneID",
            ],
          },
        },
        "HostedZoneId": "Z0EXAMPLE000000001",
        "Name": "mcp.example.com",
        "Type": "A",
      },
      "Type": "AWS::Route53::RecordSet",
    },
    "McpServerExecutionRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy",
        ],
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "secretsmanager:GetSecretValue",
                  "Effect": "Allow",
                  "Resource": [
                    "arn:aws:secretsmanager:us-east-2:111111111111:secret:example/mongo-uri-AbC123",
                    "arn:aws:secretsmanager:us-east-2:111111111111:secret:example/redis-uri-DeF456",
                  ],
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "ReadSecretsManager",
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
    "McpServerListener443": {
      "Properties": {
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "McpServerCertificate",
            },
          },
        ],
        "DefaultActions": [
          {
            "TargetGroupArn": {
              "Ref": "McpServerTargetGroup",
            },
            "Type": "forward",
          },
        ],
        "LoadBalancerArn": {
          "Ref": "McpServerAlb",
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
      },
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
    },
    "McpServerListener80": {
      "Properties": {
        "DefaultActions": [
          {
            "RedirectConfig": {
              "Port": "443",
              "Protocol": "HTTPS",
              "StatusCode": "HTTP_301",
            },
            "Type": "redirect",
          },
        ],
        "LoadBalancerArn": {
          "Ref": "McpServerAlb",
        },
        "Port": 80,
        "Protocol": "HTTP",
      },
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
    },
    "McpServerLogGroup": {
      "Properties": {
        "LogGroupName": "/ecs/mcp-prod-mcp-server",
        "RetentionInDays": 30,
      },
      "Type": "AWS::Logs::LogGroup",
    },
    "McpServerService": {
      "DependsOn": [
        "McpServerListener80",
        "McpServerListener443",
      ],
      "Properties": {
        "Cluster": {
          "Ref": "McpServerCluster",
        },
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true,
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100,
        },
        "DesiredCount": 1,
        "HealthCheckGracePeriodSeconds": 60,
        "LaunchType": "FARGATE",
        "LoadBalancers": [
          {
            "ContainerName": "mcp-server",
            "ContainerPort": 8000,
            "TargetGroupArn": {
              "Ref": "McpServerTargetGroup",
            },
          },
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              {
                "Ref": "McpServerServiceSecurityGroup",
              },
            ],
            "Subnets": [
              "subnet-aaa",
              "subnet-bbb",
              "subnet-ccc",
            ],
          },
        },
        "ServiceName": "mcp-prod-mcp-server",
        "TaskDefinition": {
          "Ref": "McpServerTaskDefinition",
        },
      },
      "Type": "AWS::ECS::Service",
    },
    "McpServerServiceSecurityGroup": {
      "Properties": {
        "GroupDescription": "Task ingress for mcp-prod-mcp-server (from ALB only)",
        "SecurityGroupIngress": [
          {
            "FromPort": 8000,
            "IpProtocol": "tcp",
            "SourceSecurityGroupId": {
              "Ref": "McpServerAlbSecurityGroup",
            },
            "ToPort": 8000,
          },
        ],
        "VpcId": "vpc-00000000",
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
    "McpServerTargetGroup": {
      "Properties": {
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckPath": "/health",
        "HealthyThresholdCount": 2,
        "Matcher": {
          "HttpCode": "200",
        },
        "Name": "mcp-prod-tg-mcp-server",
        "Port": 8000,
        "Protocol": "HTTP",
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "60",
          },
          {
            "Key": "stickiness.enabled",
            "Value": "false",
          },
        ],
        "TargetType": "ip",
        "UnhealthyThresholdCount": 3,
        "VpcId": "vpc-00000000",
      },
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
    },
    "McpServerTaskDefinition": {
      "Properties": {
        "ContainerDefinitions": [
          {
            "Environment": [
              {
                "Name": "STAGE",
                "Value": "prod",
              },
              {
                "Name": "CW_REGION",
                "Value": "us-east-2",
              },
              {
                "Name": "MCP_ISSUER",
                "Value": "https://mcp.example.com",
              },
            ],
            "Essential": true,
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1",
              ],
              "Interval": 30,
              "Retries": 3,
              "StartPeriod": 60,
              "Timeout": 5,
            },
            "Image": "111111111111.dkr.ecr.us-east-2.amazonaws.com/example-mcp:sha-abc1234",
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "McpServerLogGroup",
                },
                "awslogs-region": {
                  "Ref": "AWS::Region",
                },
                "awslogs-stream-prefix": "mcp-server",
              },
            },
            "Name": "mcp-server",
            "PortMappings": [
              {
                "ContainerPort": 8000,
                "Protocol": "tcp",
              },
            ],
            "Secrets": [
              {
                "Name": "MONGO_URI",
                "ValueFrom": "arn:aws:secretsmanager:us-east-2:111111111111:secret:example/mongo-uri-AbC123",
              },
              {
                "Name": "REDIS_URI",
                "ValueFrom": "arn:aws:secretsmanager:us-east-2:111111111111:secret:example/redis-uri-DeF456",
              },
            ],
          },
        ],
        "Cpu": "512",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "McpServerExecutionRole",
            "Arn",
          ],
        },
        "Family": "mcp-prod-mcp-server",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE",
        ],
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "McpServerTaskRole",
            "Arn",
          ],
        },
      },
      "Type": "AWS::ECS::TaskDefinition",
    },
    "McpServerTaskRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "logs:FilterLogEvents",
                    "logs:GetLogEvents",
                  ],
                  "Effect": "Allow",
                  "Resource": "arn:aws:logs:us-east-2:111111111111:log-group:/aws/lambda/*:*",
                },
                {
                  "Action": [
                    "cognito-idp:AdminInitiateAuth",
                  ],
                  "Effect": "Allow",
                  "Resource": "arn:aws:cognito-idp:us-east-2:111111111111:userpool/us-east-2_EXAMPLE01",
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "TaskPolicy",
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
  },
}
`;
